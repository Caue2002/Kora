# Supabase - Project URL e service role key (nunca commitar valores reais)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Modelo 1 - Gemini (principal)
GEMINI_API_KEY=sua-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Modelo 2 - Groq (contingencia)
GROQ_API_KEY=sua-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Modelo 3 - Cerebras (contingencia)
CEREBRAS_API_KEY=sua-cerebras-api-key
CEREBRAS_MODEL=llama-3.3-70b

# Modelo 4 - OpenRouter (contingencia)
OPENROUTER_API_KEY=sua-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Limites de tokens por janela (valores de seguranca abaixo do teto gratuito real)
LIMITE_TOKENS_MINUTO=8000
LIMITE_TOKENS_HORA=50000
LIMITE_TOKENS_DIA=200000
MAX_TOKENS_SAIDA=600
JANELA_HISTORICO=6
