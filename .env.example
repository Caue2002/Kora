# Supabase - Project URL e service role key (nunca commitar valores reais)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Modelo 1 - Gemini (principal)
GEMINI_API_KEY=sua-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Modelo 2 - Groq (contingencia)
GROQ_API_KEY=sua-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Modelo 3 - Gemini contingencia (mesma chave do modelo 1, modelo diferente)
GEMINI_MODEL_2=gemini-3.5-flash

# Modelos 4 e 5 - Gemini fallback extra (mesma chave; troca-se o nome por env)
# Defaults validos: gemini-3.8-flash, gemini-3.5-flash-lite
# ATENCAO: gemini-2.5-flash e gemini-2.0-flash foram descontinuados (404)
GEMINI_MODEL_3=gemini-3.8-flash
GEMINI_MODEL_4=gemini-3.5-flash-lite

# Modelo 6 - Pollinations (ultimo recurso, gratuito sem chave)
POLLINATIONS_MODEL=openai

# Limites de tokens por janela (valores de seguranca abaixo do teto gratuito real)
LIMITE_TOKENS_MINUTO=30000
LIMITE_TOKENS_HORA=300000
LIMITE_TOKENS_DIA=1000000
MAX_TOKENS_SAIDA=400
JANELA_HISTORICO=6
