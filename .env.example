# Supabase - Project URL e service role key (nunca commitar valores reais)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Gemini (mesma chave para todos os slots; ordem do mais forte ao mais fraco)
GEMINI_API_KEY=sua-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Opcional: sobrescrever qualquer slot do catalogo (defaults ja estao certos)
# Catalogo padrao: hydrogen > 3.8 > 3.6 > 3.5-flash > 3-flash-preview >
# groq > 3.5-flash-lite > 3.1-flash-lite > 3.1-flash-lite-preview > pollinations
# ATENCAO: gemini-2.5-* dao 404 e gemini-4-argon/carbon/neon dao 429 no free tier
# GEMINI_MODEL=gemini-4-hydrogen
# GEMINI_MODEL_2=gemini-3.8-flash
# GEMINI_MODEL_3=gemini-3.6-flash
# GEMINI_MODEL_4=gemini-3.5-flash
# GEMINI_MODEL_5=gemini-3-flash-preview
# GEMINI_MODEL_6=gemini-3.5-flash-lite
# GEMINI_MODEL_7=gemini-3.1-flash-lite
# GEMINI_MODEL_8=gemini-3.1-flash-lite-preview

# Groq (contingencia)
GROQ_API_KEY=sua-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Pollinations (ultimo recurso, gratuito sem chave)
POLLINATIONS_MODEL=openai

# Limites de tokens por janela (valores de seguranca abaixo do teto gratuito real)
LIMITE_TOKENS_MINUTO=30000
LIMITE_TOKENS_HORA=300000
LIMITE_TOKENS_DIA=1000000
MAX_TOKENS_SAIDA=400
JANELA_HISTORICO=6
